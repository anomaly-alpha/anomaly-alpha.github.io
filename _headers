# NOTE: this is a Cloudflare Pages / Netlify config file. GitHub Pages ignores it entirely —
# the live response for every page carries `Server: GitHub.com` and `Cache-Control: max-age=600`,
# and no Referrer-Policy header. That is why Lighthouse reports "Use efficient cache lifetimes"
# on every page, and why a Permissions-Policy cannot be set here. The rules below only take
# effect if the site is ever fronted by Cloudflare Pages.

# Rarely-changed assets: 1 year
/fonts/*
  Cache-Control: public, max-age=31536000, immutable
/vendor/*
  Cache-Control: public, max-age=31536000, immutable

# CSS/JS: 1 week (lets users pick up deploys within a week)
*.css
  Cache-Control: public, max-age=604800
*.js
  Cache-Control: public, max-age=604800

# HTML entry points: 1 hour
*.html
  Cache-Control: public, max-age=3600
/
  Cache-Control: public, max-age=3600

# YouTube embeds require a valid HTTP referrer
/*
  Referrer-Policy: strict-origin-when-cross-origin
