DISCORD_TOKEN=your_bot_token_here
CLIENT_ID=your_application_id_here

# OpenAI (required for all AI features)
OPENAI_API_KEY=your_openai_api_key_here

# Model selection (optional — defaults to gpt-5.4-mini in the model router; all AI_MODEL-driven call sites fall back to gpt-5.4-mini)
# AI_MODEL=gpt-5.4-mini
# AI_MODEL_COMPLEX=gpt-5.4-mini  # Used for long/complex queries, falls back to AI_MODEL

# Sleep mode (saves usage hours). Set both to 0 to disable.
SLEEP_START=1
SLEEP_END=7
SLEEP_TIMEZONE=0

# Tavily Search API (for /search command)
# Get key: https://tavily.com → API keys (free tier 1,000 credits/month)
TAVILY_API_KEY=your_api_key_here

# Presence catalog is tracked at presence-assets/presence-phrases.json and is always the bot's status source.
# Run npm run check:presence before deployment; runtime presence makes no provider calls.

# Realm of Skarn (optional)
# REALM_DAILY_CALL_LIMIT=1000  # Realm AI calls per guild per day

# Per-guild AI spend budget (optional — chat buckets: mention/consult/musing/interjection)
# GUILD_AI_DAILY_LIMIT=2000    # Per-guild daily AI call budget (features/ai/guildBudget.js)

# Storage (optional — defaults to data/skarn.db)
# SKARN_DB_PATH=data/skarn.db
