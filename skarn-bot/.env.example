DISCORD_TOKEN=your_bot_token_here
CLIENT_ID=your_application_id_here

# OpenAI (required for all AI features)
OPENAI_API_KEY=your_openai_api_key_here

# Model selection (optional — defaults to gpt-5.4-mini in the model router; some commands still fall back to gpt-4o-mini)
# AI_MODEL=gpt-5.4-mini
# AI_MODEL_COMPLEX=gpt-5.4-mini  # Used for long/complex queries, falls back to AI_MODEL

# Sleep mode (saves usage hours). Set both to 0 to disable.
SLEEP_START=1
SLEEP_END=7
SLEEP_TIMEZONE=0

# Tavily Search API (for /search command)
# Get key: https://tavily.com → API keys (free tier 1,000 credits/month)
TAVILY_API_KEY=your_api_key_here

# Presence cycler (optional — in-bot "Watching" status pool)
# PRESENCE_POOL_SIZE=300       # Number of phrases the AI batch-generates per pool
# PRESENCE_CYCLE_MS=120000     # How often the "Watching" text advances (ms)
# PRESENCE_REFRESH_DAYS=7      # Pool regeneration interval (days)

# Realm of Skarn (optional)
# REALM_DAILY_CALL_LIMIT=1000  # Realm AI calls per guild per day

# Storage (optional — defaults to data/skarn.db)
# SKARN_DB_PATH=data/skarn.db
